generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  HR
  TL
  EMPLOYEE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum SheetStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum AttendanceKind {
  OFFICE
  WFH
}

enum PayrollStatus {
  DRAFT
  PROCESSED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
}

model User {
  id                 String    @id @default(cuid())
  empCode            String    @unique
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(EMPLOYEE)
  mustChangePassword Boolean   @default(true)
  sessionVersion     Int       @default(0)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  active             Boolean   @default(true)
  title              String?
  department         String?
  phone              String?
  dateOfJoining      DateTime? @db.Date
  ctcAnnual          Int?
  onboardingStep     Int       @default(5)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teamId String?
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  leads  Team[]  @relation("TeamLead")

  attendance        Attendance[]
  regularisations   Regularisation[]     @relation("RegOwner")
  regDecisions      Regularisation[]     @relation("RegDecider")
  trackSheets       TrackSheet[]         @relation("SheetOwner")
  sheetReviews      TrackSheet[]         @relation("SheetReviewer")
  tasks             Task[]               @relation("TaskAssignee")
  tasksCreated      Task[]               @relation("TaskCreator")
  leaveRequests     LeaveRequest[]       @relation("LeaveOwner")
  leaveDecisions    LeaveRequest[]       @relation("LeaveDecider")
  wfhRequests       WfhRequest[]         @relation("WfhOwner")
  wfhDecisions      WfhRequest[]         @relation("WfhDecider")
  payslips          Payslip[]
  goals             PerformanceGoal[]
  reviews           PerformanceReview[]  @relation("ReviewSubject")
  reviewsGiven      PerformanceReview[]  @relation("ReviewAuthor")
  enrollments       TrainingEnrollment[]
  resignations      Resignation[]
  auditEntries      AuditLog[]
  payrollRuns       PayrollRun[]
  trainingsCreated  Training[]

  @@index([teamId])
}

model Team {
  id      String  @id @default(cuid())
  name    String  @unique
  leadId  String?
  lead    User?   @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members User[]  @relation("TeamMembers")
}

model Setting {
  key   String @id
  value String
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

model Attendance {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime       @db.Date
  kind        AttendanceKind @default(OFFICE)
  punchIn     DateTime?
  punchOut    DateTime?
  inIp        String?
  outIp       String?
  timezone    String?
  late        Boolean        @default(false)
  earlyLeave  Boolean        @default(false)
  workMinutes Int            @default(0)
  regularised Boolean        @default(false)

  @@unique([userId, date])
  @@index([date])
}

model Regularisation {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("RegOwner", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  type        String
  time        String
  reason      String
  status      RequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?         @relation("RegDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId, status])
}

model TrackSheet {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation("SheetOwner", fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime    @db.Date
  project        String
  hours          Float
  description    String
  link           String?
  attachmentName String?
  attachmentType String?
  attachment     Bytes?
  status         SheetStatus @default(SUBMITTED)
  reviewerId     String?
  reviewer       User?       @relation("SheetReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote     String?
  source         String?
  createdAt      DateTime    @default(now())

  @@index([userId, date])
  @@index([status])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime   @db.Date
  status      TaskStatus @default(TODO)
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([assigneeId, status])
}

model LeaveType {
  id          String         @id @default(cuid())
  name        String         @unique
  annualQuota Int
  sortOrder   Int            @default(0)
  requests    LeaveRequest[]
}

model LeaveRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType     @relation(fields: [leaveTypeId], references: [id])
  fromDate    DateTime      @db.Date
  toDate      DateTime      @db.Date
  days        Int
  lopDays     Int           @default(0)
  reason      String
  status      RequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?         @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId, status])
}

model WfhRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("WfhOwner", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  reason      String
  status      RequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?         @relation("WfhDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId, status])
}

model PayrollRun {
  id            String        @id @default(cuid())
  month         String        @unique // YYYY-MM
  status        PayrollStatus @default(DRAFT)
  processedAt   DateTime?
  processedById String?
  processedBy   User?         @relation(fields: [processedById], references: [id], onDelete: SetNull)
  payslips      Payslip[]
}

model Payslip {
  id         String     @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gross      Int
  deductions Int
  net        Int
  lopDays    Int
  paidDays   Int
  lines      Json

  @@unique([runId, userId])
}

model PerformanceGoal {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle    String
  title    String
  kpi      String
  weight   Int
  progress Int    @default(0)

  @@index([userId, cycle])
}

model PerformanceReview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("ReviewSubject", fields: [userId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  cycle         String
  kind          String // APPRAISAL | OVERRIDE
  rating        String?
  score         Int?
  comment       String
  createdAt     DateTime @default(now())

  @@index([userId, cycle])
}

model Training {
  id          String               @id @default(cuid())
  title       String
  date        DateTime             @db.Date
  timeLabel   String
  mode        String
  host        String
  seats       Int
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  enrollments TrainingEnrollment[]
  createdAt   DateTime             @default(now())
}

model TrainingEnrollment {
  id          String           @id @default(cuid())
  trainingId  String
  training    Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ENROLLED)
  certificate String?
  createdAt   DateTime         @default(now())

  @@unique([trainingId, userId])
}

model Resignation {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt    DateTime  @default(now())
  lastWorkingDay DateTime  @db.Date
  reason         String
  comments       String?
  step           Int       @default(1)
  withdrawnAt    DateTime?

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  tone      String   @default("sky")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
